{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)"
    ],
    "ask": [
      "Bash(make clean*)",
      "Bash(docker compose * down -v*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
