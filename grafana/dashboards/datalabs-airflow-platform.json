    {
      "type": "stat",
      "title": "Scheduler heartbeat",
      "description": "rate of scheduler heartbeats over 2 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(sum(rate(airflow_scheduler_heartbeat[2m])) > bool 0, 1)",
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "✔ alive",
                  "color": "green"
                },
                "0": {
                  "text": "✖ no heartbeat",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
