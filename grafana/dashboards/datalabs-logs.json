{
  "uid": "datalabs-logs",
  "title": "DataLabs · Logs Explorer",
  "description": "Structured pipeline logs (JSON events) shipped by Promtail. Filter by DAG, level, pipeline and event.",
  "tags": [
    "datalabs",
    "logs",
    "loki"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "liveNow": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Pipeline health",
      "type": "link",
      "url": "/d/datalabs-pipeline-health",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "dag_id",
        "label": "DAG",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "dag_id",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"airflow\"}",
          "type": 1
        },
        "definition": "label_values({job=\"airflow\"}, dag_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "level",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"airflow\"}",
          "type": 1
        },
        "definition": "label_values({job=\"airflow\"}, level)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "event",
        "label": "Event",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "event",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"airflow\"}",
          "type": 1
        },
        "definition": "label_values({job=\"airflow\"}, event)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({job=\"airflow\", source=\"task\", dag_id=~\"$dag_id\", level=~\"$level\"} |~ \"(?i)$search\" [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": true,
            "lineInterpolation": "linear",
            "axisPlacement": "auto",
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARNING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Events",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"airflow\", source=\"task\", dag_id=~\"$dag_id\", level=~\"$level\", event=~\"$event\"} |~ \"(?i)$search\" | regexp `- (?P<lvl>[A-Z]+) (?P<logger>[^ :{]+): (?P<msg>.*?)(?: \\| \\{.*\\})?$` | line_format `[{{.level}}] {{.logger}} · {{ if .msg }}{{ .msg }}{{ else }}{{ __line__ }}{{ end }}`",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 14
      }
    },
    {
      "type": "logs",
      "title": "Raw task logs (everything, incl. Airflow and dbt output)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"airflow\", source=\"task\", dag_id=~\"$dag_id\", level=~\"$level\"} |~ \"(?i)$search\"",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      }
    }
  ]
}
