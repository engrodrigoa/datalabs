# =====================================================================
# DataLabs — copy to .env and change the passwords (make env does it)
# Values here are the HOST-side view; docker-compose overrides the
# container-side endpoints (DB_HOST=postgres, MINIO_ENDPOINT=http://minio:9000).
# =====================================================================

# --- Postgres (DW + Airflow metadata in a separate "airflow" database)
DB_USER=datalab
DB_PASSWORD=change-me-db
DB_DB=datalab
DB_HOST=localhost
DB_PORT=5432

# --- Grafana read-only DB role (created by infra/postgres/init/00_bootstrap.sh)
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# --- Airflow
# Linux: run `id -u` and use your uid
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_ADMIN_EMAIL=admin@example.org

# --- MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_ENDPOINT=http://localhost:9005
MINIO_BUCKET_AUDIT=audit

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Pipelines
# monthly ANP files from this year on (laptop friendly)
ANP_MONTHLY_FROM_YEAR=2026
# default reference month (the dag_rfb param overrides it)
RFB_REF_MONTH=2026-08
# Receita Federal WebDAV share token (only for the RFB pipeline)
RFB_SHARE_TOKEN=

# --- AI / RAG (docker compose --profile ai; build with INSTALL_AI=true)
INSTALL_AI=false
RAG_UF=GO
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_MIN_ROUTING_ACC=0.9
RAG_MIN_VALUE_ACC=0.9
OLLAMA_MODEL=llama3.2:1b

# --- Alerting (optional: without these, alerts are only logged as `event=alert`)
ALERT_MIN_SEVERITY=warning
ALERT_WEBHOOK_URL=
# slack | discord | generic
ALERT_WEBHOOK_FORMAT=slack
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
