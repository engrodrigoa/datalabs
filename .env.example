# =====================================================================
# DataLabs — copy to .env and change the passwords (make env does it)
# Values here are the HOST-side view; docker-compose overrides the
# container-side endpoints (DB_HOST=postgres, MINIO_ENDPOINT=http://minio:9000).
# =====================================================================

# --- Postgres (DW + Airflow metadata in a separate "airflow" database)
DB_USER=datalab
DB_PASSWORD=change-me-db
DB_DB=datalab
DB_HOST=localhost
DB_PORT=5432

# --- Grafana read-only DB role (created by infra/postgres/init/00_bootstrap.sh)
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# --- Airflow
# Linux: run `id -u` and use your uid
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_ADMIN_EMAIL=admin@example.org
# Shared by webserver and scheduler (signs the served task logs: without it each container makes its own key
# and the UI gets "403 FORBIDDEN" reading logs) and encryption of Connections/Variables. `make env` generates
# both, also into an existing .env that lacks them. Keep them stable: a new FERNET_KEY cannot decrypt what the
# old one encrypted. Empty FERNET_KEY = Airflow stores secrets unencrypted (CI only).
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-airflow-secret
AIRFLOW__CORE__FERNET_KEY=

# --- MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_ENDPOINT=http://localhost:9005
MINIO_BUCKET_AUDIT=audit

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Pipelines
# monthly ANP files from this year on (laptop friendly)
ANP_MONTHLY_FROM_YEAR=2026
# default reference month (the dag_rfb param overrides it)
RFB_REF_MONTH=2026-08
# Receita Federal public share (CNPJ open data). A PUBLIC link, not a secret: empty = the link built into
# pipelines/rfb/rfb01_download_files.py. When the Receita re-creates the share, paste the browser link here.
RFB_SHARE_URL=
# folder of the monthly subfolders (YYYY-MM) inside the share
RFB_SHARE_DIR=/Dados/Cadastros/CNPJ
# the source is flaky under bursts: retries per request, pause between files, max backoff
# RFB_HTTP_RETRIES=6
# RFB_REQUEST_INTERVAL_S=1.0
# RFB_BACKOFF_MAX_S=60

# --- AI / RAG (docker compose --profile ai; build with INSTALL_AI=true)
INSTALL_AI=false
RAG_UF=GO
# embedding model: e5-small = 384 dims (default, fast on CPU); e5-base = 768 dims (~3x slower).
# Changing it triggers a full rebuild of ai.rag_context_anp on the next run (detected automatically).
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RAG_TORCH_THREADS=6
# RAG_FULL_REFRESH=1
RAG_MIN_ROUTING_ACC=0.9
RAG_MIN_VALUE_ACC=0.9
OLLAMA_MODEL=llama3.2:1b

# --- Legislation RAG: LC 214/2025 (pipelines/rag/lc214)
# source: the "norma atualizada" PDF published by the Camara (re-published when the law is amended)
# LC214_PDF_URL=https://www2.camara.leg.br/legin/fed/leicom/2025/leicomplementar-214-16-janeiro-2025-796905-normaatualizada-pl.pdf
# structural source contract (lc01): a smaller file is a truncated download
# LC214_MIN_PAGES=250
# share of the body words that must land in a provision (lc02 invariant I4)
# LC214_MIN_COVERAGE=0.98
# chunking (lc03): token limit of the embedding model; auto = real tokenizer when the AI image has it, else estimate
# LC214_MAX_TOKENS=512
# LC214_TOKENS=auto
# where the artifacts live: s3 (the stack's lake, MINIO_* above) or file:///abs/dir (no stack)
# LC214_LAKE=s3
# serving load (lc04): more than this % of the served provisions leaving at once fails the run (broken parse)
# LC214_MAX_DELETE_PCT=5
# router (ADR 0012): minimum share of the law's citations of itself the router must resolve (golden contract R3)
# LC214_MIN_SELF_REF=0.99
# SQL answers: a provision longer than this many words is paged ("parte 1 de 7"), never cut
# LC214_ANSWER_PAGE_WORDS=400
# vector search (lc04c, ADR 0013): chunks returned per question (lc05 scores hit@k / coverage@k on them)
# LC214_TOP_K=5
# context budget, in LLM tokens: (num_ctx - answer reserve - fixed prompt - question) x (1 - margin)
# 6144: same context_recall as 8192 on the golden set, ~5% less generation time on CPU (ADR 0015)
# LC214_NUM_CTX=6144
# LC214_ANSWER_TOKENS=1024
# LC214_PROMPT_TOKENS=500
# LC214_BUDGET_MARGIN=0.2
# option C: an article up to this many LLM tokens goes whole into the context, a bigger one in layers
# (2,000 ~ 1,170 words: the smallest ceiling that kept every context gain measured by lc05 on 2026-10-18)
# LC214_ANCHOR_MAX_TOKENS=2000
# LLM tokens are ESTIMATED from words until the generation step calibrates the ratio with prompt_eval_count
# LC214_LLM_TOKENS_PER_WORD=1.7
# retrieval gate (lc05, ADR 0014): a run fails when a gated metric drops more than this many cases below
# pipelines/rag/lc214/eval_baseline.yml (1 case = 1/n: ~3 pp with ~30 fiscal phrasings)
# LC214_EVAL_TOLERANCE_CASES=1
# answer generation (lc06, ADR 0015): OLLAMA_MODEL above, temperature 0; the seed makes runs repeatable and is part
# of the fingerprint (a new seed = a new report); the timeout is per call (the first one loads the model on CPU)
# LC214_GEN_SEED=42
# LC214_GEN_TIMEOUT_S=600
# prompt variant (lc06 VARIANTS, composed with '+'): baseline | verdict_last | answer_default. Part of the
# fingerprint: a new variant is a new report. Iterate with `lc06_generate --golden --dev --variant <name>`
# LC214_GEN_VARIANT=baseline
# Restricted network (corporate TLS inspection blocks the Hugging Face CDN): bring the model with
# `make models-export` (machine with access) + `make models-import` (here), then uncomment:
# HF_HUB_OFFLINE=1

# --- Alerting (optional: without these, alerts are only logged as `event=alert`)
ALERT_MIN_SEVERITY=warning
ALERT_WEBHOOK_URL=
# slack | discord | generic
ALERT_WEBHOOK_FORMAT=slack
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
